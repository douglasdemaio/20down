{
  "name": "20down",
  "version": "0.1.0",
  "private": true,
  "description": "20 Down — a three- or four-player trick-taking game with free play and USDC wagering on Solana",
  "workspaces": [
    "client",
    "worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @20down/client",
    "dev:client": "npm run dev -w @20down/client",
    "dev:worker": "npm run dev -w @20down/worker",
    "deploy:worker": "npm run deploy -w @20down/worker",
    "build": "npm run build -w @20down/client",
    "build:client": "npm run build -w @20down/client",
    "typecheck": "npm run typecheck -w @20down/shared && npm run typecheck -w @20down/client && npm run typecheck -w @20down/worker",
    "test": "npm run test:shared && npm run test:worker",
    "test:shared": "npm run test -w @20down/shared",
    "test:worker": "npm run test -w @20down/worker",
    "chain:build": "anchor build",
    "chain:test": "anchor test",
    "chain:test:local": "anchor test --skip-build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "scheduler": "~0.23.2"
  },
  "engines": {
    "node": ">=20"
  }
}
