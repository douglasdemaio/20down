{
  "name": "20down",
  "version": "0.1.0",
  "private": true,
  "description": "20 Down — a three- or four-player trick-taking game with free play and USDC wagering on Solana",
  "workspaces": [
    "app",
    "server",
    "client",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @20down/client",
    "dev:client": "npm run dev -w @20down/client",
    "dev:legacy-server": "npm run dev -w @20down/server",
    "dev:legacy-app": "npm run dev -w @20down/app",
    "build": "npm run build -w @20down/client",
    "build:client": "npm run build -w @20down/client",
    "build:legacy": "npm run build -w @20down/app && npm run build -w @20down/server",
    "typecheck": "npm run typecheck -w @20down/shared && npm run typecheck -w @20down/client",
    "typecheck:legacy": "npm run typecheck -w @20down/server && npm run typecheck -w @20down/app",
    "test": "npm run test:shared",
    "test:shared": "npm run test -w @20down/shared",
    "test:legacy-server": "npm run test -w @20down/server",
    "chain:build": "anchor build",
    "chain:test": "anchor test",
    "chain:test:local": "anchor test --skip-build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "scheduler": "~0.23.2"
  },
  "engines": {
    "node": ">=20"
  }
}
