# Dice & Cards — configuration
# Copy to .env (or export) and adjust. Variables span the game server, the
# Next.js app and optional deployment tooling.

# ---------------- Game server (server/) ----------------

# Host/port the realtime hub listens on.
HOST=0.0.0.0
PORT=8787

# Cluster and RPC. devnet | mainnet-beta | localnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program id (the deployed @solana/program id for escrow + payouts).
PROGRAM_ID=CrjnJ5xQjSYUw4vkKKRfWtQFCc58EoA82ZXodNDwjHXt

# USDC mint. On devnet use 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Treasury wallet (fee recipient).
TREASURY=J59EPyPHf9wtoLjf8rG4f9cARnLnUPKCdNwZX241rakh

# Oracle keypair: the server identity that creates tables, commits seeds and
# submits settlements. Devnet-wallet default below must be well funded.
ORACLE_KEYPAIR=/home/you/.config/solana/id.json

# Master switch. Wager mode is off until this is true.
CHAIN_ENABLED=true

# Only on a fresh devnet/localnet: lets the server initialize the program
# config. Set to false (default) in production deployments.
ALLOW_CONFIG_INIT=false

# Platform fee per player per game, in USDC base units (0.02 USDC).
FEE_PER_PLAYER=20000

# Turn / re-ante clocks (ms). Spec target is 60000.
TURN_TIMEOUT_MS=60000
ANTE_TIMEOUT_MS=60000

# Browser origin allowed to talk to the API ("*" for development).
CORS_ORIGIN=*

# ---------------- Next.js app (app/) ----------------

# Public cluster shown to players (devnet until mainnet after audit).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Where the app finds the game server.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
# Optional explicit override; defaults to the /ws of SERVER_URL.
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws

# Cluster-aware RPC for wallet adapter.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Mirror of the program id / mint used above.
NEXT_PUBLIC_PROGRAM_ID=CrjnJ5xQjSYUw4vkKKRfWtQFCc58EoA82ZXodNDwjHXt
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---------------- Compliance ----------------

# ISO country codes, comma separated, that are geo-blocked. Empty = permit all
# (devnet default). e.g. "US,IR,NL" — the app reads x-vercel-ip-country /
# cf-ipcountry / x-country-code headers.
GEO_BLOCKED_COUNTRIES=

# ---------------- Solana CLI / Anchor ----------------

ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=/home/you/.config/solana/id.json
